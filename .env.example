# Copy to .env and fill in. .env is git-ignored; never commit a real key.
#
# The tool itself never reads this file: it reads the credential, and the settings below, from the environment
# only (FR-1.3a).
# Load it into the environment with uv:
#   uv run --env-file .env agentic-review review
#   uv run --env-file .env python scripts/s1_tool_calling_probe.py --runs 50

# The API key for the endpoint below. Required for any review that reaches the model.
AGENTIC_REVIEW_API_KEY=

# The model and the OpenAI-compatible endpoint to review with. Both are optional: unset or blank means the built-in
# default, or whatever the reviewed repository's .agentic-review.yml sets. When set here they win over that file, so
# you can point your own checkout at another provider without touching the committed configuration. A base URL that
# is not an http:// or https:// URL stops the run (exit 3) before anything is sent.
AGENTIC_REVIEW_MODEL=
AGENTIC_REVIEW_BASE_URL=



LANGFUSE_PUBLIC_KEY="pk-lf-..."
LANGFUSE_SECRET_KEY="sk-lf-..."
# Set host URL: Cloud US/EU or local host
LANGFUSE_BASE_URL="https://cloud.langfuse.com" # Or "http://localhost:3000" if self-hosted
